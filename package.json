{
  "name": "patchlingo",
  "private": true,
  "version": "0.1.0",
  "description": "Translate multi-effects presets between devices (Valeton GP-200 to Hotone Ampero Mini).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "decode": "vite-node scripts/decode.ts",
    "convert": "vite-node scripts/convert.ts",
    "report:mapping": "vite-node scripts/mapping-report.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
